{
    // Ready-to-run profile template: the VIIPER HID backend for a game that
    // blocks simulated input. Copy next to slitherin.exe (as-is or renamed
    // within the slitherin.*.json pattern). Requires viiper.exe + the usbip-win2
    // driver; see ARCHITECTURE.md §10 for setup.
    // Hard-fail: if this profile is active and VIIPER is unavailable, the
    // profile does NOT run and the tray shows the alert — no silent fallback.
    // Mouse output is NOT possible on viiper (HID keyboard) — no `button`
    // steps, no mouse-key chords, not even inside wrappers.
    "schema_version": 1,
    "name": "Game B (CharacterC - Sarlona) — VIIPER",

    // Override the global input_engine for just this profile.
    "input_engine": "viiper",

    "window": {
        "exe": "dndclient64.exe",
        "title": "CharacterC - Sarlona"
    },

    "wrappers": {
        "bar6": {
            "before": [ { "keys": "Ctrl+6" } ],
            "after":  [ { "keys": "Ctrl+1" } ]
        }
    },

    "macros": [
        {
            "name": "Combat Cycle (real keyboard)",
            "trigger": "LButton",
            "fire_after_ms": 1000,
            "toggle": "Pause",
            "toggle_sound": {
                "on":  { "frequency": 1500, "duration_ms": 80 },
                "off": { "frequency": 1000, "duration_ms": 80 }
            },
            "loop": { "count": -1 },
            "schedule": { "mode": "cooldown", "fire_delay_ms": 700 },
            "steps": [
                { "keys": "0", "cooldown_ms": 3000 },
                { "keys": "6", "cooldown_ms": 3000 },
                { "keys": "7", "cooldown_ms": 10000 },
                { "keys": "8", "cooldown_ms": 15000 },
                { "keys": "7", "cooldown_ms": 15000, "wrapper": "bar6" }
            ]
        },
        {
            "name": "Buff Self",
            "trigger": "Ctrl+K",
            "steps": [
                { "sound": {} },
                { "keys": "1" },
                { "keys": "2", "wait_ms": 0 }
            ]
        }
    ]
}