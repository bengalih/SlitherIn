{
    // Combat cycle macro, expressed in the new unified vocabulary.
    // Arm with the toggle key (Pause), then HOLD LButton to cycle: each pass
    // fires every action whose cooldown has expired, paced by fire_delay_ms.
    "schema_version": 1,
    "name": "Main (CharacterA - Sarlona)",

    // Window target for gating + AUTO profile selection. Both optional;
    // exe-only is the single-instance default.
    "window": {
        "exe": "dndclient64.exe",
        "title": "CharacterA - Sarlona"
    },

    // Reusable before/after step sets. The hotbar-6 action switches bar to
    // Ctrl+6, presses the key, then returns to bar 1 — plain key steps, no
    // game-specific "hotbar" keyword.
    "wrappers": {
        "bar6": {
            "before": [ { "keys": "Ctrl+6" } ],
            "after":  [ { "keys": "Ctrl+1" } ]
        }
    },

    "macros": [
        {
            "name": "Combat Cycle",
            "trigger": "LButton",
            // hold the trigger this long before the cycle starts (the old
            // arm_delay_ms / TheDelayBeforeStarting)
            "fire_after_ms": 1000,
            "toggle": "Pause",
            "toggle_sound": {
                "on":  { "frequency": 1500, "duration_ms": 80 },
                "off": { "frequency": 1000, "duration_ms": 80 }
            },
            // -1 = run until toggled off / released / aborted
            "loop": { "count": -1 },
            // cooldown mode: fire every ready action each pass, paced 700 ms
            "schedule": { "mode": "cooldown", "fire_delay_ms": 700 },
            "steps": [
                { "keys": "0", "cooldown_ms": 3000 },
                { "keys": "6", "cooldown_ms": 3000 },
                { "keys": "7", "cooldown_ms": 10000 },
                { "keys": "8", "cooldown_ms": 15000 },
                { "keys": "7", "cooldown_ms": 15000, "wrapper": "bar6" }
            ]
        }
    ]
}